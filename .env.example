# IP Vault — variables de entorno de producción.
# Copia este archivo a .env (o a los secretos del entorno de despliegue elegido)
# y rellena los valores reales. Ninguna de estas variables tiene un valor por
# defecto seguro para producción: sin ellas, /admin cae a un código de acceso
# de desarrollo y los leads no se envían por correo (quedan solo en el log del
# servidor). Ver CLAUDE.md, sección "Abierto".

# Servidor de Correo (Resend) — src/lib/lead-notify.ts
# Sin RESEND_API_KEY no se manda ningún correo de lead.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# Panel de Administración / Admin Auth — src/lib/admin-auth.ts
# Sin estas dos, /admin usa un código y un secreto de sesión de solo desarrollo.
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=

# Identidad Legal y RGPD — src/config/company.ts (aviso de privacidad)
# Sin COMPANY_NIF / COMPANY_ADDRESS, PrivacyNotice omite esos dos datos en vez
# de inventarlos. Rellénalas con los datos registrales reales antes de publicar
# un enlace de outbound a un prospecto real.
COMPANY_LEGAL_NAME=
COMPANY_NIF=
COMPANY_ADDRESS=
